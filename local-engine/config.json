      "rmdir\\s+/[sS]\\s+/[qQ]\\s+[cC]:\\\\",
      ":\\(\\)\\s*\\{\\s*:\\|:&\\s*\\};:",
      "dd\\s+if="
    ]
  },
  "providers": {
    "ollama": {
      "baseUrl": "http://localhost:11434",
      "model": "llama3.2"
    },
    "gemini": {
      "model": "gemini-2.0-flash"
    },
    "anthropic": {
      "model": "claude-3-5-sonnet-20241022"
    },
    "openai": {
      "model": "gpt-4o"
    }
  }
