{
  "port": 3721,
  "host": "127.0.0.1",
  "authToken": "",
  "activeProvider": "hybrid",
  "hybridRoutingPolicy": "balanced",
  "approvedDirectories": [
    "."
  ],
  "approvedApplications": [
    "code",
    "notepad",
    "calc",
    "cmd",
    "powershell",
    "wt",
